//
// This file defines macros used for generating SIL instruction parser visitor
// methods. This is part of the refactoring effort to replace the large switch
// statement in parseSpecificSILInstruction with a visitor pattern.
//
// Related GitHub Issue: swift#42962 (SR-340)
//
//===----------------------------------------------------------------------===//

#ifndef PARSE_SIL_VISITOR_ENTRY
#define PARSE_SIL_VISITOR_ENTRY(ID)
#endif

// Phase 1: AllocBoxInst (1 instruction) - Infrastructure validation
PARSE_SIL_VISITOR_ENTRY(AllocBoxInst)

// Phase 2: Basic instructions (14 instructions total)
// Apply-family (6 instructions)
PARSE_SIL_VISITOR_ENTRY(ApplyInst)
PARSE_SIL_VISITOR_ENTRY(BeginApplyInst)
PARSE_SIL_VISITOR_ENTRY(PartialApplyInst)
PARSE_SIL_VISITOR_ENTRY(TryApplyInst)
PARSE_SIL_VISITOR_ENTRY(AbortApplyInst)
PARSE_SIL_VISITOR_ENTRY(EndApplyInst)

// Tuple-family (5 instructions)
PARSE_SIL_VISITOR_ENTRY(TupleInst)
PARSE_SIL_VISITOR_ENTRY(TupleExtractInst)
PARSE_SIL_VISITOR_ENTRY(TupleElementAddrInst)
PARSE_SIL_VISITOR_ENTRY(TuplePackExtractInst)
PARSE_SIL_VISITOR_ENTRY(TuplePackElementAddrInst)

// Metatype-family (3 instructions)
PARSE_SIL_VISITOR_ENTRY(MetatypeInst)
PARSE_SIL_VISITOR_ENTRY(ValueMetatypeInst)
PARSE_SIL_VISITOR_ENTRY(ExistentialMetatypeInst)

// Phase 3: High-frequency instructions
// Phase 3-1: Alloc/Dealloc Batch 1 - Simple instructions (9 instructions)
PARSE_SIL_VISITOR_ENTRY(AllocStackInst)
PARSE_SIL_VISITOR_ENTRY(AllocPackInst)
PARSE_SIL_VISITOR_ENTRY(AllocPackMetadataInst)
PARSE_SIL_VISITOR_ENTRY(DeallocStackInst)
PARSE_SIL_VISITOR_ENTRY(DeallocStackRefInst)
PARSE_SIL_VISITOR_ENTRY(DeallocPackInst)
PARSE_SIL_VISITOR_ENTRY(DeallocPackMetadataInst)
PARSE_SIL_VISITOR_ENTRY(DeallocRefInst)
PARSE_SIL_VISITOR_ENTRY(DeallocPartialRefInst)

// Phase 3-2: Alloc/Dealloc Batch 2 - Complex instructions (6 instructions)
PARSE_SIL_VISITOR_ENTRY(AllocRefInst)
PARSE_SIL_VISITOR_ENTRY(AllocRefDynamicInst)
PARSE_SIL_VISITOR_ENTRY(AllocGlobalInst)
PARSE_SIL_VISITOR_ENTRY(AllocExistentialBoxInst)
PARSE_SIL_VISITOR_ENTRY(BeginDeallocRefInst)
PARSE_SIL_VISITOR_ENTRY(DeallocExistentialBoxInst)

// Phase 3-3: Struct/Enum families (12 instructions total)
// Struct-family (3 instructions)
PARSE_SIL_VISITOR_ENTRY(StructInst)
PARSE_SIL_VISITOR_ENTRY(StructExtractInst)
PARSE_SIL_VISITOR_ENTRY(StructElementAddrInst)

// Enum-family (9 instructions)
PARSE_SIL_VISITOR_ENTRY(EnumInst)
PARSE_SIL_VISITOR_ENTRY(InitEnumDataAddrInst)
PARSE_SIL_VISITOR_ENTRY(UncheckedEnumDataInst)
PARSE_SIL_VISITOR_ENTRY(UncheckedTakeEnumDataAddrInst)
PARSE_SIL_VISITOR_ENTRY(InjectEnumAddrInst)
PARSE_SIL_VISITOR_ENTRY(SelectEnumInst)
PARSE_SIL_VISITOR_ENTRY(SelectEnumAddrInst)
PARSE_SIL_VISITOR_ENTRY(SwitchEnumInst)
PARSE_SIL_VISITOR_ENTRY(SwitchEnumAddrInst)

// Phase 3-4: Load/Store basic instructions (4 instructions)
PARSE_SIL_VISITOR_ENTRY(LoadInst)
PARSE_SIL_VISITOR_ENTRY(LoadBorrowInst)
PARSE_SIL_VISITOR_ENTRY(StoreInst)
PARSE_SIL_VISITOR_ENTRY(StoreBorrowInst)

// Phase 3-5: Copy/Destroy/Move instructions (5 instructions)
PARSE_SIL_VISITOR_ENTRY(DestroyValueInst)
PARSE_SIL_VISITOR_ENTRY(DestroyNotEscapedClosureInst)
PARSE_SIL_VISITOR_ENTRY(CopyAddrInst)
PARSE_SIL_VISITOR_ENTRY(ExplicitCopyAddrInst)
PARSE_SIL_VISITOR_ENTRY(MarkUnresolvedMoveAddrInst)

// Phase 3-6: Move/Wrapper instructions (6 instructions)
PARSE_SIL_VISITOR_ENTRY(MoveValueInst)
PARSE_SIL_VISITOR_ENTRY(MarkUnresolvedNonCopyableValueInst)
PARSE_SIL_VISITOR_ENTRY(CopyableToMoveOnlyWrapperValueInst)
PARSE_SIL_VISITOR_ENTRY(MoveOnlyWrapperToCopyableValueInst)
PARSE_SIL_VISITOR_ENTRY(MoveOnlyWrapperToCopyableAddrInst)
PARSE_SIL_VISITOR_ENTRY(CopyableToMoveOnlyWrapperAddrInst)

// Phase 3-7: Conversion/Cast instructions (8 instructions)
PARSE_SIL_VISITOR_ENTRY(UncheckedRefCastInst)
PARSE_SIL_VISITOR_ENTRY(UncheckedTrivialBitCastInst)
PARSE_SIL_VISITOR_ENTRY(UncheckedBitwiseCastInst)
PARSE_SIL_VISITOR_ENTRY(ConvertFunctionInst)
PARSE_SIL_VISITOR_ENTRY(BridgeObjectToRefInst)
PARSE_SIL_VISITOR_ENTRY(BridgeObjectToWordInst)
PARSE_SIL_VISITOR_ENTRY(UpcastInst)
PARSE_SIL_VISITOR_ENTRY(RefToRawPointerInst)

// Phase 3-8: Control Flow instructions (9 instructions)
PARSE_SIL_VISITOR_ENTRY(ReturnInst)
PARSE_SIL_VISITOR_ENTRY(ThrowInst)
PARSE_SIL_VISITOR_ENTRY(ThrowAddrInst)
PARSE_SIL_VISITOR_ENTRY(UnwindInst)
PARSE_SIL_VISITOR_ENTRY(YieldInst)
PARSE_SIL_VISITOR_ENTRY(BranchInst)
PARSE_SIL_VISITOR_ENTRY(CondBranchInst)
PARSE_SIL_VISITOR_ENTRY(UnreachableInst)
PARSE_SIL_VISITOR_ENTRY(CondFailInst)

// Phase 3-9: Additional Cast/Conversion instructions (18 instructions)
PARSE_SIL_VISITOR_ENTRY(UncheckedAddrCastInst)
PARSE_SIL_VISITOR_ENTRY(UncheckedValueCastInst)
PARSE_SIL_VISITOR_ENTRY(AddressToPointerInst)
PARSE_SIL_VISITOR_ENTRY(RawPointerToRefInst)
#define LOADABLE_REF_STORAGE(Name, ...)                                        \
  PARSE_SIL_VISITOR_ENTRY(RefTo##Name##Inst)                                   \
  PARSE_SIL_VISITOR_ENTRY(Name##ToRefInst)
#include "swift/AST/ReferenceStorage.def"
#undef LOADABLE_REF_STORAGE
PARSE_SIL_VISITOR_ENTRY(ThinToThickFunctionInst)
PARSE_SIL_VISITOR_ENTRY(ThickToObjCMetatypeInst)
PARSE_SIL_VISITOR_ENTRY(ObjCToThickMetatypeInst)
PARSE_SIL_VISITOR_ENTRY(ConvertEscapeToNoEscapeInst)
PARSE_SIL_VISITOR_ENTRY(ObjCExistentialMetatypeToObjectInst)
PARSE_SIL_VISITOR_ENTRY(ObjCMetatypeToObjectInst)
PARSE_SIL_VISITOR_ENTRY(PointerToAddressInst)
PARSE_SIL_VISITOR_ENTRY(RefToBridgeObjectInst)

#undef PARSE_SIL_VISITOR_ENTRY
